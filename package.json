{
  "name": "lacantera",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sistema de control interno para cantera: inventario, compras, ventas, nomina, tesoreria y explotacion",
  "scripts": {
    "manual": "node scripts/manual-a-html.mjs",
    "predev": "npm run manual",
    "dev": "vite",
