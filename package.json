    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview --host",
    "prueba": "node pruebas/correr.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.110.8",
